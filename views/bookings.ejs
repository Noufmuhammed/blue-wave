
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Bookings - Blue Wave</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

   
    <%- include('./partials/navbar.ejs') %>
    <% if (toast) { %>
  <div class="toast">
    ✅ <%= toast %>
  </div>
   <% } %>


   
    <main class="bookings-page">

       
        <section class="bookings-header">

            <p class="hero-subtitle">
                YOUR SURFING PLANS
            </p>

            <h1>
                My Bookings
            </h1>

            <p>
                Manage your upcoming surfing lessons.
            </p>

        </section>


        
        <% if (bookings.length === 0) { %>

            <section class="empty-bookings">

                <h2>
                    No bookings yet 🌊
                </h2>

                <p>
                    Find a lesson and reserve your spot!
                </p>

                <a href="/lessons" class="btn-primary">
                    View Lessons
                </a>

            </section>

        <% } %>


        
        <section class="bookings-grid">

            <% bookings.forEach(booking => { %>

             <article class="booking-card">

                   
                    <h2>
                        <%= booking.lesson.level %> Lesson
                    </h2>


                   
                    <div class="booking-details">

                        <p>
                            <strong>Date</strong>
                            <%= booking.lesson.date %>
                        </p>

                        <p>
                            <strong>Time</strong>
                            <%= booking.lesson.time %>
                        </p>

                        <p>
                            <strong>Instructor</strong>
                            <%= booking.lesson.instructor %>
                        </p>

                        <p>
                            <strong>Package</strong>
                            <%= booking.lesson.package %>
                        </p>

                    </div>


                    
                    <p class="booking-price">
                        Lesson Price:
                        <%= booking.lesson.price %> BHD
                    </p>


                   
                    <% if (booking.waterAwareness) { %>

                        <p class="booking-addon">
                            Water Awareness Class
                            <span>+5 BHD</span>
                        </p>

                        <p class="booking-total">
                            Total:
                            <%= booking.lesson.price + 5 %> BHD
                        </p>

                    <% } else { %>

                        <p class="booking-addon">
                            Water Awareness Class:
                            Not Added
                        </p>

                        <p class="booking-total">
                            Total:
                            <%= booking.lesson.price %> BHD
                        </p>

                    <% } %>


                    
                    <div class="booking-actions">

                        <a
                            href="/bookings/<%= booking._id %>/edit"
                            class="btn-secondary"
                        >
                            Edit Booking
                        </a>


                        <form
                            action="/bookings/<%= booking._id %>/delete"
                            method="POST"
                        >

                            <button type="submit" class="btn-danger">
                                Cancel Booking
                            </button>

                        </form>

                    </div>

                </article>

            <% }) %>

        </section>

    </main>

</body>

</html>

