<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Blue Wave</title>

  <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navigation bar -->
    <%- include('./partials/navbar.ejs') %>


    <!-- Hero section -->
    <section class="hero">

        <div class="container">

            <div class="hero-content">

                <p class="hero-subtitle">
                    SURF • LEARN • RIDE
                </p>

                <h1 class="hero-title">
                    Welcome to Blue Wave 🌊
                </h1>

                <p class="hero-description">
                    You can't control the waves,
                    but you can learn how to surf.
                </p>

                <a href="/lessons" class="btn-primary">
                    View Surfing Lessons
                </a>

            </div>

        </div>


        <!-- Surfing image -->
     <div class="hero-image-wrapper">

    <img
        src="/surf.jpg"
        alt="Surfer riding a wave"
    >

    <svg
        class="hero-wave"
        viewBox="0 0 1440 120"
        preserveAspectRatio="none"
        aria-hidden="true"
    >

        <path
            d="M0,65 C180,120 360,10 540,65 C720,120 900,10 1080,65 C1260,120 1350,45 1440,65 L1440,120 L0,120 Z"
        ></path>

    </svg>

</div>

    </section>


    <!-- About Blue Wave section -->
    <section class="about-section">

        <div class="about-content">

            <div class="about-label">

                <span></span>

                <p>
                    ABOUT BLUE WAVE
                </p>

            </div>


            <div class="about-layout">

                <!-- Brand side -->
                <div class="about-brand">

                    <h2>
                        BLUE
                    </h2>

                    <h2>
                        WAVE
                    </h2>

                    <div class="about-wave"></div>

                </div>


                <!-- About text -->
                <div class="about-text">

                    <h3>
                        Your surfing journey starts here.
                    </h3>

                    <p>
                        At Blue Wave, we believe every great surfing journey
                        starts with one wave. Our goal is to make learning to surf
                        simple, exciting, and accessible by connecting you with
                        lessons for different skill levels and experience.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Why Blue Wave section -->
    <section class="why-section">

        <div class="why-content">

            <!-- Section heading -->
            <div class="why-header">

                <p class="hero-subtitle">
                    WHY BLUE WAVE
                </p>

                <h2>
                    Everything You Need to Catch the Wave
                </h2>

            </div>


            <!-- Feature list -->
            <div class="feature-list">

                <!-- Feature 01 -->
                <article class="feature-item">

                    <div class="feature-number">
                        01
                    </div>

                    <div class="feature-info">

                        <h3>
                            Learn to Surf
                        </h3>

                        <p>
                            Build your surfing skills with lessons designed
                            for different experience levels.
                        </p>

                    </div>

                </article>


                <!-- Feature 02 -->
                <article class="feature-item">

                    <div class="feature-number">
                        02
                    </div>

                    <div class="feature-info">

                        <h3>
                            All Skill Levels
                        </h3>

                        <p>
                            Choose from beginner, intermediate, and advanced
                            surfing lessons.
                        </p>

                    </div>

                </article>


                <!-- Feature 03 -->
                <article class="feature-item">

                    <div class="feature-number">
                        03
                    </div>

                    <div class="feature-info">

                        <h3>
                            Water Awareness
                        </h3>

                        <p>
                            Add a Water Awareness Class to your booking
                            for extra water safety knowledge.
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </section>


</body>

</html>