<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us - Blue Wave</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

    <%- include('./partials/navbar.ejs') %>


   
    <main class="contact-page">

       
        <section class="contact-header">

            <h1>
                Contact Us
            </h1>

            <p>
                Have a question about our lessons or bookings?
                We'd love to hear from you.
            </p>

        </section>


       
        <section class="contact-content">

            <div class="contact-info">

                <h2>
                    Get in Touch
                </h2>

                <p>
                    Our Blue Wave team is here to help with questions
                    about lessons, packages, bookings, and water safety.
                </p>


                <div class="contact-detail">

                    <strong>
                        Email
                    </strong>

                    <p>
                        <a href=mailto:support@bluewavesurf.com>
                            support@bluewavesurf.com
                        </a>
                    </p>

                </div>


                <div class="contact-detail">

                    <strong>
                        Phone
                    </strong>

                  <p>
                 <a href="tel:+97317002222">
                 +973 1700 2222
              </a>
              </p>

                </div>


                <div class="contact-detail">

                    <strong>
                        Location
                    </strong>

                    <p>
                        Bahrain
                    </p>

                </div>

            </div>


            
            <div class="contact-form-section">

                <h2>
                    Send Us a Message
                </h2>

                <p>
                    For questions about lessons, bookings, or water safety,
                    please contact us using the details provided.
                </p>

                <a
                    href="mailto:support@bluewavesurf.com"
                    class="btn-primary"
                >
                    Email Blue Wave
                </a>

            </div>

        </section>

    </main>

</body>

</html>