
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Edit Booking - Blue Wave</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

  
    <%- include('./partials/navbar.ejs') %>


    
    <main class="edit-booking-page">

       
        <section class="edit-booking-header">

            <p class="hero-subtitle">
                CHANGE YOUR PLANS
            </p>

            <h1>
                Edit Booking
            </h1>

            <p>
                Update your surfing lesson details.
            </p>

        </section>


        
        <form
            action="/bookings/<%= booking._id %>"
            method="POST"
            class="edit-booking-form"
        >

            
            <label for="lessonId">
                Choose a different lesson
            </label>

            <select name="lessonId" id="lessonId">

                <% lessons.forEach(lesson => { %>

                    <option
                        value="<%= lesson._id %>"
                        data-price="<%= lesson.price %>"
                        <%= booking.lesson._id.toString() === lesson._id.toString() ? "selected" : "" %>
                    >
                        <%= lesson.date %> -
                        <%= lesson.time %> -
                        <%= lesson.level %> -
                        <%= lesson.instructor %> -
                        <%= lesson.package %> -
                        <%= lesson.price %> BHD
                    </option>

                <% }) %>

            </select>


           
            <label class="edit-addon">

                <input
                    type="checkbox"
                    name="waterAwareness"
                    value="true"
                    id="waterAwareness"
                    <%= booking.waterAwareness ? "checked" : "" %>
                >

                Add Water Awareness Class

                <span>
                    +5 BHD
                </span>

            </label>


           
            <div class="edit-total">

                <span>
                    Total
                </span>

                <strong>
                    <span id="totalPrice">
                        <%= booking.lesson.price + (booking.waterAwareness ? 5 : 0) %>
                    </span>
                    BHD
                </strong>

            </div>


           
            <button type="submit" class="btn-primary">
                Update Booking
            </button>


            <a href="/bookings" class="cancel-edit">
                Go Back
            </a>

        </form>

    </main>


   
    <script>

       
        const lessonSelect = document.querySelector("#lessonId")
        const waterAwareness = document.querySelector("#waterAwareness")
        const totalPrice = document.querySelector("#totalPrice")


       
        function updateTotal() {

            
            const selectedLesson =
                lessonSelect.options[lessonSelect.selectedIndex]

           
            const lessonPrice =
                Number(selectedLesson.dataset.price)

          
            const total =
                lessonPrice + (waterAwareness.checked ? 5 : 0)

            
            totalPrice.textContent = total
        }


       
        lessonSelect.addEventListener(
            "change",
            updateTotal
        )


        
        waterAwareness.addEventListener(
            "change",
            updateTotal
        )

    </script>

</body>

</html>

