```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Surfing Lessons - Blue Wave</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navigation bar -->
    <%- include('./partials/navbar.ejs') %>


    <!-- Lessons heading -->
    <main class="lessons-page">

        <section class="lessons-header">

            <p class="hero-subtitle">
                FIND YOUR WAVE
            </p>

            <h1>
                Surfing Lessons
            </h1>

            <p>
                Choose a lesson and start your surfing adventure!
            </p>

        </section>


        <!-- Lesson cards -->
        <section class="lessons-grid">

            <% lessons.forEach(lesson => { %>

                <article class="lesson-card">

                    <!-- Lesson level -->
                    <h2>
                        <%= lesson.level %> Lesson
                    </h2>


                    <!-- Lesson details -->
                    <div class="lesson-details">

                        <p>
                            <strong>Date</strong>
                            <%= lesson.date %>
                        </p>

                        <p>
                            <strong>Time</strong>
                            <%= lesson.time %>
                        </p>

                        <p>
                            <strong>Instructor</strong>
                            <%= lesson.instructor %>
                        </p>

                        <p>
                            <strong>Package</strong>
                            <%= lesson.package %>
                        </p>

                    </div>


                    <!-- Price -->
                    <p class="lesson-price">
                        <%= lesson.price %> BHD
                    </p>


                    <!-- Booking form -->
                    <form action="/bookings" method="POST">

                        <!-- Sends the lesson ID -->
                        <input
                            type="hidden"
                            name="lessonId"
                            value="<%= lesson._id %>"
                        >


                        <!-- Water Awareness Class -->
                        <label class="water-awareness">

                            <input
                                type="checkbox"
                                name="waterAwareness"
                                value="true"
                            >

                            Add Water Awareness Class
                            <span>+5 BHD</span>

                        </label>


                        <!-- Book button -->
                        <button type="submit">
                            Book This Lesson
                        </button>

                    </form>

                </article>

            <% }) %>

        </section>

    </main>

</body>

</html>
```
