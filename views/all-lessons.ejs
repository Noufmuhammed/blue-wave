<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Surfing Lessons</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <!-- Navigation bar -->
    <%- include('./partials/navbar.ejs') %>

    <h1>Surfing Lessons</h1>

    <p>Choose a lesson and start your surfing adventure!</p>


    <!-- Show every lesson -->
    <% lessons.forEach(lesson => { %>

        <div>

            <h2>
                <%= lesson.level %> Lesson
            </h2>

            <p>
                Date: <%= lesson.date %>
            </p>

            <p>
                Time: <%= lesson.time %>
            </p>

            <p>
                Instructor: <%= lesson.instructor %>
            </p>

            <p>
                Package: <%= lesson.package %>
            </p>

            <p>
                Price: <%= lesson.price %> BHD
            </p>


            <!-- Booking form -->
            <form action="/bookings" method="POST">

                <!-- Sends the lesson ID to bookings.js -->
                <input
                    type="hidden"
                    name="lessonId"
                    value="<%= lesson._id %>"
                >

                <!-- Optional Water Awareness Class -->
                <label>
                    <input
                        type="checkbox"
                        name="waterAwareness"
                        value="true"
                    >

                    Add Water Awareness Class (+5 BHD)
                </label>

                <br><br>

                <button type="submit">
                    Book This Lesson
                </button>

            </form>

        </div>

    <% }) %>


</body>

</html>