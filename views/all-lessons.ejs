<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Surfing Lessons - Blue Wave</title>

   <link rel="stylesheet" href="/style.css">
</head>

<body>

    
    <%- include('./partials/navbar.ejs') %>


    
    <main class="lessons-page">

       
        <section class="lessons-header">

            <p class="hero-subtitle">
                FIND YOUR WAVE
            </p>

            <h1>
                Surfing Lessons
            </h1>

            <p>
                Choose a lesson that matches your experience and start your
                surfing journey.
            </p>

        </section>


        
        <section class="lessons-grid">

            <% lessons.forEach(lesson => { %>

                <article class="lesson-card">

                    
                    <div class="lesson-level">
                        <span>
                            <%= lesson.level %>
                        </span>

                        <span>
                            SURF LESSON
                        </span>
                    </div>


                   
                    <h2>
                        Learn to Ride
                    </h2>


                    
                    <div class="lesson-details">

                        <div class="lesson-detail">

                            <span>
                                DATE
                            </span>

                            <strong>
                                <%= lesson.date %>
                            </strong>

                        </div>


                        <div class="lesson-detail">

                            <span>
                                TIME
                            </span>

                            <strong>
                                <%= lesson.time %>
                            </strong>

                        </div>


                        <div class="lesson-detail">

                            <span>
                                INSTRUCTOR
                            </span>

                            <strong>
                                <%= lesson.instructor %>
                            </strong>

                        </div>


                        <div class="lesson-detail">

                            <span>
                                PACKAGE
                            </span>

                            <strong>
                                <%= lesson.package %>
                            </strong>

                        </div>

                    </div>


                    
                    <div class="lesson-price">

                        <span>
                            FROM
                        </span>

                        <strong>
                            <%= lesson.price %> BHD
                        </strong>

                    </div>


                    
                    <form action="/bookings" method="POST">

                        
                        <input
                            type="hidden"
                            name="lessonId"
                            value="<%= lesson._id %>"
                        >


                        
                        <label class="water-awareness">

                            <input
                                type="checkbox"
                                name="waterAwareness"
                                value="true"
                            >

                            <span>
                                Add Water Awareness Class
                            </span>

                            <strong>
                                +5 BHD
                            </strong>

                        </label>


                        
                        <button type="submit">
                            Book This Lesson
                        </button>

                    </form>

                </article>

            <% }) %>

        </section>

    </main>

</body>

</html>